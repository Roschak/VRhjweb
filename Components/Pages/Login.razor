@page "/login"
@layout EmptyLayout
@inject NavigationManager Nav
@inject LocalizationService L
@implements IDisposable

<PageTitle>@L["login.pageTitle"]</PageTitle>

<div class="login-hero">
    <div class="login-tools">
        <LanguageSwitcher />
    </div>

    <div class="login-card">
        <div class="login-mark"><i class="ph-fill ph-cube"></i></div>
        <h2 class="gold-text">HajjVR</h2>
        <p class="login-sub">@L["login.subtitle"]</p>
        <div class="bismillah small">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>

        @if (HasError)
        {
            <div class="nb-card nb-danger nb-flat login-alert">
                ❌ @L["login.error"]
            </div>
        }

        <form method="post" action="/auth/login" class="login-form">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label class="nb-label">@L["login.username"]</label>
            <input class="nb-input" type="text" name="username" placeholder="@L["login.usernamePh"]" required autofocus />
            <label class="nb-label" style="margin-top:.9rem">@L["login.password"]</label>
            <input class="nb-input" type="password" name="password" placeholder="••••••••" required />
            <button type="submit" class="nb-btn primary login-submit">
                @L["login.submit"]
            </button>
        </form>

        <div class="login-forgot">
            <a href="/forgot-password">@L["login.forgot"]</a>
        </div>

        <div class="nb-card nb-gold nb-flat login-demo">
            <strong>@L["login.demo"]</strong>
            <span class="mono">admin/admin123</span> · <span class="mono">jamaah01/jamaah01123</span>
        </div>
    </div>
</div>

@code {
    private bool _langSub;
    protected override void OnParametersSet()
    {
        if (!_langSub) { _langSub = true; L.OnChanged += StateHasChanged; }
    }
    public void Dispose() => L.OnChanged -= StateHasChanged;

    private bool HasError;
    private string ReturnUrl = "/dashboard";

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = System.Web.HttpUtility.ParseQueryString(uri.Query);
        HasError = q["error"] == "1";
        if (q["returnUrl"] is { Length: > 0 } r && r.StartsWith('/')) ReturnUrl = r;
    }
}
