@page "/reset-password"
@layout EmptyLayout
@inject AuthService Auth
@inject NavigationManager Nav
@inject LocalizationService L
@implements IDisposable

<PageTitle>@L["rp.pageTitle"]</PageTitle>

<div class="login-hero">
    <div class="login-tools">
        <LanguageSwitcher />
    </div>

    <div class="nb-card login-card">
        <h3>@L["rp.title"]</h3>

        @if (_done)
        {
            <div class="nb-card nb-primary nb-flat mt-1r">@L["rp.done"] <a href="/login">@L["rp.loginNow"]</a></div>
        }
        else
        {
            <label class="nb-label">@L["rp.token"]</label>
            <input class="nb-input mono" @bind="_token" />
            <label class="nb-label" style="margin-top:.8rem">@L["rp.newPassword"]</label>
            <input class="nb-input" type="password" @bind="_password" />
            <button class="nb-btn primary mt-1r" style="width:100%; justify-content:center" @onclick="Submit">@L["rp.submit"]</button>
            @if (_error)
            {
                <div class="nb-card nb-danger nb-flat mt-1r">@L["rp.error"]</div>
            }
        }
    </div>
</div>

@code {
    private bool _langSub;
    protected override void OnParametersSet()
    {
        if (!_langSub) { _langSub = true; L.OnChanged += StateHasChanged; }
    }
    public void Dispose() => L.OnChanged -= StateHasChanged;

    private string _token = "";
    private string _password = "";
    private bool _done, _error;

    protected override void OnInitialized()
    {
        var q = System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query);
        _token = q["token"] ?? "";
    }

    private async Task Submit()
    {
        _error = false;
        if (_password.Length < 6) { _error = true; return; }
        _done = await Auth.ResetPasswordAsync(_token.Trim(), _password);
        _error = !_done;
    }
}
