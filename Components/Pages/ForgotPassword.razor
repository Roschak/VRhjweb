@page "/forgot-password"
@layout EmptyLayout
@inject AuthService Auth
@inject LocalizationService L
@implements IDisposable

<PageTitle>@L["fp.pageTitle"]</PageTitle>

<div class="login-hero">
    <div class="login-tools">
        <LanguageSwitcher />
    </div>

    <div class="nb-card login-card">
        <h3>@L["fp.title"]</h3>
        <p class="muted login-hint">@L["fp.hint"]</p>

        <label class="nb-label">@L["fp.identity"]</label>
        <input class="nb-input" @bind="_identity" placeholder="@L["fp.identityPh"]" />
        <button class="nb-btn primary mt-1r" style="width:100%; justify-content:center" @onclick="Submit">@L["fp.submit"]</button>

        @if (_token is not null)
        {
            <div class="nb-card nb-primary nb-flat mt-1r" style="font-size:.9rem">
                @L["fp.created"]<br />
                <a href="/reset-password?token=@_token" class="mono">/reset-password?token=@_token</a>
            </div>
        }
        else if (_notFound)
        {
            <div class="nb-card nb-danger nb-flat mt-1r">@L["fp.notFound"]</div>
        }

        <div style="text-align:center; margin-top:1rem"><a href="/login">@L["fp.back"]</a></div>
    </div>
</div>

@code {
    private bool _langSub;
    protected override void OnParametersSet()
    {
        if (!_langSub) { _langSub = true; L.OnChanged += StateHasChanged; }
    }
    public void Dispose() => L.OnChanged -= StateHasChanged;

    private string _identity = "";
    private string? _token;
    private bool _notFound;

    private async Task Submit()
    {
        _token = await Auth.CreateResetTokenAsync(_identity.Trim());
        _notFound = _token is null;
    }
}
