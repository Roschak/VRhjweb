@page "/simulation"
@attribute [Authorize]
@inject LocalizationService L

<PageTitle>@L["sim.pageTitle"]</PageTitle>

<div class="sim-page">
    <div class="flex space-between flex-wrap">
        <h1>@L["sim.title"]</h1>
        <span class="nb-chip blue mono">VR V2 Active</span>
    </div>

    <div class="iframe-container">
        <iframe src="https://v-rhajiproject-oi6x.vercel.app/" 
                allow="fullscreen; xr-spatial-tracking; vr; gyroscope; accelerometer" 
                allowfullscreen="true"
                class="vr-iframe">
        </iframe>
    </div>
</div>

<style>
    .iframe-container {
        width: 100%;
        height: calc(100vh - 180px); 
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        margin-top: 1rem;
        background-color: #000; /* Supaya saat loading layarnya hitam elegan */
    }
    .vr-iframe {
        width: 100%;
        height: 100%;
        border: none;
    }
</style>
