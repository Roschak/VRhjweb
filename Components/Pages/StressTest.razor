@page "/stress-test"
@attribute [Authorize(Roles = "Admin,Operator")]
@implements IAsyncDisposable
@implements IDisposable
@inject IJSRuntime JS
@inject LocalizationService L

<PageTitle>@L["st.pageTitle"]</PageTitle>

<h1>@L["st.title"]</h1>
<p class="muted">@L["st.subtitle"]</p>

<div class="sim-toolbar">
    @foreach (var n in new[] { 1000, 3000, 5000, 10000, 15000, 20000 })
    {
        <button class="nb-btn small @(_crowd == n ? "primary" : null)" @onclick="() => SetCrowd(n)">@n.ToString("n0")</button>
    }
    <span class="nb-chip @(FpsClass)">FPS: @_lastFps</span>
    <span class="nb-chip">Draw calls: @_drawCalls</span>
    <span class="nb-chip">Δ Tri: @_triangles.ToString("n0")</span>
</div>

<div class="sim-canvas-wrap" style="height: 52vh">
    <canvas @ref="_canvasEl"></canvas>
</div>

<div class="nb-card mt-1r">
    <h3>@L["st.fpsHistory"]</h3>
    <svg viewBox="0 0 600 120" style="width:100%">
        <line x1="0" y1="60" x2="600" y2="60" stroke="var(--ink-soft)" stroke-dasharray="4" stroke-width="1" />
        @((MarkupString)"<text x='4' y='56' font-size='10' fill='var(--ink-soft)'>30 fps</text>")
        @if (_fpsHistory.Count > 1)
        {
            <polyline fill="none" stroke="var(--primary)" stroke-width="2.5" points="@FpsPolyline" />
        }
    </svg>
</div>

@code {
    private bool _langSub;
    protected override void OnParametersSet()
    {
        if (!_langSub) { _langSub = true; L.OnChanged += StateHasChanged; }
    }
    public void Dispose() => L.OnChanged -= StateHasChanged;

    private ElementReference _canvasEl;
    private IJSObjectReference? _module;
    private int _crowd = 5000;
    private int _lastFps, _drawCalls;
    private long _triangles;
    private readonly Queue<int> _fpsHistory = new();
    private Timer? _timer;

    private string FpsClass => _lastFps >= 45 ? "green" : _lastFps >= 25 ? "orange" : "red";

    private string FpsPolyline => string.Join(" ",
        _fpsHistory.Select((f, i) => $"{i * 600.0 / Math.Max(59, _fpsHistory.Count - 1):0},{Math.Max(2, 120 - f * 2):0}"));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hajjvr3d.js");
        await _module.InvokeAsync<bool>("init", _canvasEl, new { scene = "haram", crowd = _crowd, timeOfDay = 13.0 });
        _timer = new Timer(async _ =>
        {
            try
            {
                if (_module is null) return;
                var s = await _module.InvokeAsync<SimStats>("getStats");
                _lastFps = s.fps; _drawCalls = s.drawCalls; _triangles = s.triangles;
                _fpsHistory.Enqueue(s.fps);
                while (_fpsHistory.Count > 60) _fpsHistory.Dequeue();
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        }, null, 1000, 1000);
    }

    private async Task SetCrowd(int n)
    {
        _crowd = n;
        if (_module is not null) await _module.InvokeVoidAsync("setCrowd", n);
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose"); await _module.DisposeAsync(); } catch { }
        }
    }

    private record SimStats(int fps, int agents, int drawCalls, long triangles);
}
