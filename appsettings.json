{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "SQLite"
  },
  "ConnectionStrings": {
    "SQLite": "Data Source=Data/hajjvr_local.db",
    "SQLServer": "Server=localhost;Database=HajjVR;Trusted_Connection=True;TrustServerCertificate=True",
    "MySQL": "Server=localhost;Database=hajjvr;User=root;Password=;",
    "PostgreSQL": "Host=localhost;Database=hajjvr;Username=postgres;Password=postgres"
  },

  "Storage": {
    "Provider": "FileSystem",
    "FileSystem": { "Path": "uploads" },
    "Azure": { "ConnectionString": "", "Container": "hajjvr" },
    "S3": { "AccessKey": "", "SecretKey": "", "Bucket": "hajjvr", "Region": "ap-southeast-1", "ServiceUrl": "" },
    "MinIO": { "AccessKey": "minioadmin", "SecretKey": "minioadmin", "Bucket": "hajjvr", "ServiceUrl": "http://localhost:9000" }
  },

  "Llm": {
    "Provider": "OpenAI",
    "Temperature": 0.7,
    "MaxTokens": 2048,
    "SystemPrompt": "",
    "OpenAI": { "Model": "gpt-4o-mini", "ApiKey": "sk-proj-xxx", "Endpoint": "https://api.openai.com/v1" },
    "Anthropic": { "Model": "claude-sonnet-5", "ApiKey": "", "Endpoint": "https://api.anthropic.com/v1" },
    "Gemini": { "Model": "gemini-2.5-flash", "ApiKey": "", "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai" },
    "Ollama": { "Model": "llama3.2", "ApiKey": "ollama", "Endpoint": "http://localhost:11434/v1" }
  },

  "Embedding": {
    "Provider": "OpenAI",
    "Model": "text-embedding-3-small",
    "ApiKey": "sk-proj-xxxx",
    "Endpoint": "https://api.openai.com/v1"
  },

  "Tavily": {
    "ApiKey": "tvly-dev-xxxx"
  },

  "Api": {
    "Key": "hajjvr-demo-key"
  }
}